# Copy this file to `.env.local` and fill in real local values.
# Never commit real secrets: `.env*` is ignored except this template.

# Postgres connection string (local Docker Postgres arrives with the dev-env issue).
DATABASE_URL="postgresql://user:password@localhost:5432/tensr"

# Auth.js session/magic-link secret. Generate with `openssl rand -base64 32`.
AUTH_SECRET="replace-me"

# LLM provider key behind the ModelProvider adapter.
OPENROUTER_API_KEY="replace-me"
